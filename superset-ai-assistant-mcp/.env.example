# OpenAI API
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.4-mini

# Optional release/build visibility
ASSISTANT_RELEASE_VERSION=
ASSISTANT_BUILD_SHA=
ASSISTANT_BUILD_TIMESTAMP=

# Superset built-in MCP runtime
SUPERSET_PRODUCT_MCP_RUNTIME=built_in_stdio
# Optional explicit launcher if the current Python environment does not include superset.mcp_service
# This is typically required for the standalone assistant Docker image unless you use built_in_http.
SUPERSET_BUILT_IN_MCP_COMMAND=
SUPERSET_BUILT_IN_MCP_ARGS=
# Optional HTTP transport override instead of stdio
# SUPERSET_BUILT_IN_MCP_URL=http://127.0.0.1:8090/mcp

# Superset connection
SUPERSET_BASE_URL=http://103.54.18.91:8088
SUPERSET_PUBLIC_URL=http://103.54.18.91:8088

# Assistant auth (login/password)
AUTH_DB_PATH=/home/superset_ai/superset-ai-assistant-mcp/data/auth.db
AUTH_JWT_SECRET=change_me_please
AUTH_JWT_TTL_HOURS=12
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_HISTORY_MAX_MESSAGES=500

# AI agent limits
AI_AGENT_MAX_STEPS=10
AI_AGENT_RECURSION_LIMIT=30
AI_AGENT_MAX_RECURSION_LIMIT=160
AI_AGENT_HISTORY_MESSAGES=3
AI_AGENT_HISTORY_CHARS=700
AI_AGENT_HISTORY_ITEM_CHARS=220
AI_AGENT_CONTEXT_CHARS=900
AI_AGENT_USER_MESSAGE_CHARS=900
AI_AGENT_RATE_LIMIT_COOLDOWN_SECONDS=20

# US1 scanner tuning
US1_ONLY_POSTGRES=true
US1_MAX_TABLES_PER_DB=120
US1_TIMEOUT_SECONDS=30

# US2 glossary storage
GLOSSARY_DB_PATH=/home/superset_ai/superset-ai-assistant-mcp/data/glossary.db

# US3 mapping rules storage
US3_RULES_DB_PATH=/home/superset_ai/superset-ai-assistant-mcp/data/us3_mapping_rules.db

# US5 criteria builder storage
US5_DB_PATH=/home/superset_ai/superset-ai-assistant-mcp/data/us5_query_builder.db

# US10-US12 guardrails
US10_12_DB_PATH=/home/superset_ai/superset-ai-assistant-mcp/data/us10_12_guardrails.db
US10_BLOCK_NON_SERVICE_INPUT=true
US10_BLOCK_PROMPT_INJECTION=true
US11_DEFAULT_ROLE=analyst
US11_ALLOWED_TABLES=birth_names,sales
US11_PII_PATTERNS=email,phone,password,passport,address
US11_ROW_FILTERS_JSON={"analyst":"country = 'RU'"}
US12_MAX_REQUESTS_PER_MINUTE=8
US12_MAX_REQUESTS_PER_HOUR=120
US12_MAX_COMPLEXITY_SCORE=16

# US13-US15 preview/viz/share
US13_15_TIMEOUT_SECONDS=30
US13_PREVIEW_LIMIT=20
US15_SHARE_BASE_URL=http://103.54.18.91:8088
