# Optional unified local dev stack overrides for docker-compose.dev.yml
# Standard deploy helper:
#   ./docker/dev/deploy-primary-stack.sh
# Low-level compose path:
#   docker compose --env-file .env.dev -f docker-compose.dev.yml up -d
# after copying this file to `.env.dev`.

OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5.4-mini
ASSISTANT_DEPLOYMENT_MODE=development
SUPERSET_LOAD_EXAMPLES=no

# Public URL exposed from the dev compose stack to your browser
SUPERSET_PUBLIC_URL=http://103.54.18.91:8088
DEV_SUPERSET_PORT=8088
DEV_API_PORT=8100
DEV_NEXTJS_PORT=3001
DEV_PAGILA_PORT=5433

# Optional direct CORS override for FastAPI if you access it without Next.js proxy
API_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Optional structured assistant log location inside the assistant-api container.
# Leave empty to use the default data/logs path.
ASSISTANT_LOG_DIR=

# Optional release/build visibility. deploy-primary-stack.sh fills these automatically.
ASSISTANT_RELEASE_VERSION=
ASSISTANT_BUILD_SHA=
ASSISTANT_BUILD_TIMESTAMP=

# Demo PostgreSQL source for local review/demo flows
DEMO_PAGILA_ENABLED=yes
DEMO_PAGILA_DB=pagila
DEMO_PAGILA_USER=pagila
DEMO_PAGILA_PASSWORD=pagila

# Assistant auth settings. development keeps weak-secret checks as warnings;
# production turns them into hard failures.
AUTH_JWT_SECRET=dev-only-secret-change-me
AUTH_JWT_TTL_HOURS=12
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_HISTORY_MAX_MESSAGES=500
